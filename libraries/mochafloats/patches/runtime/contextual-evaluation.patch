    private static final class Flow extends RuntimeException {
        final StatementExpression.Op statement;
        final Value value;
        Flow(StatementExpression.Op statement, Value value) {
            super(null, null, false, false);
            this.statement = statement;
            this.value = value;
        }
    }

    private boolean truth(Value value) {
        return scope instanceof ContextualScope contextual ? contextual.truth(value) : value.getAsBoolean();
    }

    private Value present(Value value) {
        if (value != null && !(value instanceof JavaValue reference && reference.value() == null)) return value;
        throw MissingValue.INSTANCE;
    }

