{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "kltyton_bedrock_runtime_examples:example_model_particle",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "minecraft:particle/generic_1"
      },
      "type": "kltyton_bedrock_runtime:model_particle"
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": false,
        "rotation": false,
        "velocity": false
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 3,
        "max_particles": 12
      },
      "minecraft:emitter_lifetime_looping": {
        "active_time": 3.0,
        "sleep_time": 1.0
      },
      "minecraft:emitter_shape_point": {
        "offset": [0.0, 0.35, 0.0],
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.5, 2.5)"
      },
      "minecraft:particle_initial_speed": "math.random(0.1, 0.35)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0.0, -0.25, 0.0],
        "linear_drag_coefficient": 0.8,
        "rotation_acceleration": 60.0,
        "rotation_drag_coefficient": 1.5
      },
      "kltyton_bedrock_runtime:model_appearance": {
        "size": [
          "0.35 + math.sin(variable.particle_age * 180) * 0.05",
          "0.35 + math.sin(variable.particle_age * 180) * 0.05",
          "0.35 + math.sin(variable.particle_age * 180) * 0.05"
        ],
        "facing_camera_mode": "lookat_xyz",
        "model": "kltyton_bedrock_runtime_examples:example_model"
      }
    }
  }
}
