{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.kltyton.bedrockruntime.KltytonBedrockRuntime"
        ],
        "client": [
            "com.kltyton.bedrockruntime.client.KltytonBedrockRuntimeFabricClient"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.model.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "fabric-key-binding-api-v1": "*",
        "minecraft": "${fabric_minecraft_version_range}",
        "java": ">=${java_version}",
        "forgeconfigapiport": ">=${forge_config_api_port_version}",
        "geckolib": "=${geckolib_version}"
    },
    "accessWidener": "kltyton_bedrock_runtime.accesswidener"
}
